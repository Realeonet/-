# Скопируйте этот файл в .env (install.bat делает это сам) и при необходимости заполните.
# Файл .env не попадает в git.

# Где лежит база данных. По умолчанию — папка data рядом с приложением.
# ВАЖНО: это должна быть обычная локальная папка, НЕ синхронизируемая с Google Drive / OneDrive:
# синхронизация может повредить открытую базу.
DATA_DIR=

# Куда складывать зашифрованные бэкапы. Здесь как раз удобно указать папку Google Drive —
# тогда зашифрованная копия сама уходит в облако. Пример:
# BACKUP_DIR=D:\G-Drive Mirror\finance-backups
BACKUP_DIR=

# Необязательно: путь к TTF-шрифту для PDF (нужны кириллица и иврит). На Windows берётся Arial.
PDF_FONT=

# Ключи API сейчас не нужны: все источники работают без ключей.
# Если позже подключите источник с ключом — храните ключ только здесь, не в коде.
